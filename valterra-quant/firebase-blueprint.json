{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated institutional client or analyst profile linked to Google Auth.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Full display name from Google profile",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email",
          "maxLength": 180
        },
        "photoURL": {
          "type": "string",
          "description": "Google profile avatar URL",
          "maxLength": 500
        },
        "roleLabel": {
          "type": "string",
          "description": "User account role or profile label",
          "maxLength": 60
        },
        "defaultCapital": {
          "type": "number",
          "description": "Default portfolio investment capital in USD (0 when onboarding)"
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether the user has completed initial portfolio onboarding"
        },
        "activePortfolioName": {
          "type": "string",
          "description": "User active portfolio display name",
          "minLength": 1,
          "maxLength": 100
        },
        "activeSector": {
          "type": "string",
          "description": "User active sector preset",
          "enum": [
            "tecnologia",
            "consumo",
            "biotecnologia",
            "mineria",
            "bancario",
            "multisector"
          ]
        },
        "activeTickers": {
          "type": "array",
          "description": "User active selected ticker symbols (0 to 12)"
        },
        "activeWeights": {
          "type": "array",
          "description": "User active custom weights matching activeTickers (0 to 12)"
        },
        "activeRiskPreference": {
          "type": "string",
          "description": "User active risk preference",
          "enum": ["conservador", "moderado", "agresivo"]
        },
        "activeObjective": {
          "type": "string",
          "description": "User active optimization objective",
          "enum": ["maxSharpe", "minRisk", "custom"]
        },
        "activeRange": {
          "type": "string",
          "description": "User active historical window",
          "enum": ["3mo", "6mo", "1y", "2y"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-seen timestamp"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "SavedPortfolio": {
      "title": "SavedPortfolio",
      "description": "User-configured or Random Forest optimized multi-asset portfolio mandate.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Portfolio mandate name",
          "minLength": 1,
          "maxLength": 100
        },
        "sector": {
          "type": "string",
          "description": "Sector classification",
          "enum": [
            "tecnologia",
            "consumo",
            "biotecnologia",
            "mineria",
            "bancario",
            "multisector"
          ]
        },
        "tickers": {
          "type": "array",
          "description": "Bounded list of ticker symbols (1 to 12)"
        },
        "weights": {
          "type": "array",
          "description": "Bounded list of normalized weights corresponding to tickers"
        },
        "sharpeRatio": {
          "type": "number",
          "description": "Annualized Sharpe Ratio at snapshot"
        },
        "weightedVariance": {
          "type": "number",
          "description": "Annualized portfolio weighted variance"
        },
        "standardDeviation": {
          "type": "number",
          "description": "Annualized portfolio standard deviation"
        },
        "expectedReturn": {
          "type": "number",
          "description": "Annualized expected return"
        },
        "riskFreeRate": {
          "type": "number",
          "description": "Risk-free rate used in Sharpe calculation"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "sector",
        "tickers",
        "weights",
        "sharpeRatio",
        "weightedVariance",
        "standardDeviation",
        "expectedReturn",
        "riskFreeRate",
        "createdAt",
        "updatedAt"
      ]
    },
    "StressTestRun": {
      "title": "StressTestRun",
      "description": "Persisted macroeconomic stress test simulation result for a portfolio.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "portfolioName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "scenarioName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "marketShockPct": {
          "type": "number"
        },
        "volMultiplier": {
          "type": "number"
        },
        "rateShiftBps": {
          "type": "number"
        },
        "stressedReturn": {
          "type": "number"
        },
        "stressedVolatility": {
          "type": "number"
        },
        "stressedSharpe": {
          "type": "number"
        },
        "var95": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "portfolioName",
        "sector",
        "scenarioName",
        "marketShockPct",
        "volMultiplier",
        "rateShiftBps",
        "stressedReturn",
        "stressedVolatility",
        "stressedSharpe",
        "var95",
        "createdAt"
      ]
    },
    "SavedReport": {
      "title": "SavedReport",
      "description": "Immutable financial analysis or stress test report owned by the authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reportType": {
          "type": "string",
          "enum": ["financial_analysis", "stress_test"]
        },
        "reportFingerprint": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "portfolioName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sector": {
          "type": "string",
          "enum": [
            "tecnologia",
            "consumo",
            "biotecnologia",
            "mineria",
            "bancario",
            "multisector"
          ]
        },
        "portfolioValue": {
          "type": "number"
        },
        "tickers": {
          "type": "array",
          "description": "2 to 12 asset ticker symbols"
        },
        "weights": {
          "type": "array",
          "description": "Normalized asset weights matching tickers"
        },
        "assetDetails": {
          "type": "array",
          "description": "Per-asset metrics and stress impact snapshot"
        },
        "modelParams": {
          "type": "object",
          "description": "Quantitative model configuration parameters"
        },
        "stressParams": {
          "type": "object",
          "description": "Stress scenario parameters when reportType is stress_test"
        },
        "metrics": {
          "type": "object",
          "description": "Calculated return, volatility, variance, Sharpe, VaR 95%, CVaR 95%, drawdown"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "reportType",
        "reportFingerprint",
        "portfolioName",
        "sector",
        "portfolioValue",
        "tickers",
        "weights",
        "assetDetails",
        "modelParams",
        "metrics",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private authenticated user profile document strictly isolated to ownerId == userId."
    },
    "/users/{userId}/portfolios/{portfolioId}": {
      "schema": { "$ref": "#/entities/SavedPortfolio" },
      "description": "Saved investment portfolios and Random Forest optimal weight allocations owned by userId."
    },
    "/users/{userId}/stressTests/{testId}": {
      "schema": { "$ref": "#/entities/StressTestRun" },
      "description": "Saved macroeconomic stress-testing simulation logs owned by userId."
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": { "$ref": "#/entities/SavedReport" },
      "description": "Reproducible saved financial analysis and stress test reports isolated to userId."
    }
  }
}
